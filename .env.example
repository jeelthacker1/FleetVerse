# Local-only development defaults. Compose binds public services to loopback.
DEMO_MODE=true
COOKIE_SECURE=false
ADMIN_PASSWORD=
POSTGRES_PASSWORD=local-development-only
ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Production: DEMO_MODE=false, COOKIE_SECURE=true, strong unique passwords,
# HTTPS reverse proxy, exact origins, private database and Redis networks.
